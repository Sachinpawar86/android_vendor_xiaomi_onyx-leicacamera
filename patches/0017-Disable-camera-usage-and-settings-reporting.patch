+++ b/AndroidManifest.xml
@@ -122,7 +122,7 @@
         <meta-data android:name="miui.supportFlipFullScreen" android:value="0"/>
         <meta-data android:name="miui.screenOrientation" android:value="1.sensor,2.portrait,3.fullSensor,4.sensorPortrait"/>
         <meta-data android:name="miui.isIgnoreOrientationRequest" android:value="true"/>
-        <service android:name="com.android.camera.statistic.SettingUploadJobService" android:permission="android.permission.BIND_JOB_SERVICE"/>
+        <service android:enabled="false" android:name="com.android.camera.statistic.SettingUploadJobService" android:permission="android.permission.BIND_JOB_SERVICE"/>
         <receiver android:exported="true" android:name="com.android.camera.CameraButtonIntentReceiver">
             <intent-filter>
                 <action android:name="android.intent.action.CAMERA_BUTTON"/>
