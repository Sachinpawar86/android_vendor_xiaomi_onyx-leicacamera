From dc88e0966074db44005378f633a283def405df10 Mon Sep 17 00:00:00 2001
From: Sachin <sachinbarange86@gmail.com>
Date: Tue, 3 Nov 2026 15:03:33 +0000
Subject: [PATCH] Select the watermark branding by hardware region instead of
 one hardcoded stamp

The device tree identifies the market with ro.boot.hwc (GL, CN, IN) and derives
every per-region value from it, so the watermark now follows the same signal.
onyx.d() carries both brand/model pairs - REDMI Turbo 4 Pro at index 0 for
China and POCO F7 at index 1 for the global markets - and v7/b.m() takes the
global pair whenever the cached hwc value is not CN, replacing the capability
probe that always resolved to a single hardcoded stamp.

Signed-off-by: Sachin <sachinbarange86@gmail.com>
---
 smali_classes3/onyx.smali | 16 ++++++++++++++--
 smali_classes5/v7/b.smali | 27 ++++++++++++++++++++++++++-
 2 files changed, 40 insertions(+), 3 deletions(-)

diff --git a/smali_classes3/onyx.smali b/smali_classes3/onyx.smali
index f242c547..943a4efc 100644
--- a/smali_classes3/onyx.smali
+++ b/smali_classes3/onyx.smali
@@ -495,10 +495,22 @@
 
     new-instance p0, Landroid/util/SparseArray;
 
-    const/4 v0, 0x1
+    const/4 v0, 0x2
 
     invoke-direct {p0, v0}, Landroid/util/SparseArray;-><init>(I)V
 
+    const-string v0, "REDMI"
+
+    const-string v1, "Turbo 4 Pro"
+
+    filled-new-array {v0, v1}, [Ljava/lang/String;
+
+    move-result-object v0
+
+    const/4 v1, 0x0
+
+    invoke-virtual {p0, v1, v0}, Landroid/util/SparseArray;->put(ILjava/lang/Object;)V
+
     const-string v0, "POCO"
 
     const-string v1, "F7"
@@ -507,7 +519,7 @@
 
     move-result-object v0
 
-    const/4 v1, 0x0
+    const/4 v1, 0x1
 
     invoke-virtual {p0, v1, v0}, Landroid/util/SparseArray;->put(ILjava/lang/Object;)V
 
diff --git a/smali_classes5/v7/b.smali b/smali_classes5/v7/b.smali
index e6517264..c7378c0d 100644
--- a/smali_classes5/v7/b.smali
+++ b/smali_classes5/v7/b.smali
@@ -627,6 +627,29 @@
     return v0
 .end method
 
+.method private static isChinaRegion(Ljava/lang/String;)Z
+    .locals 1
+
+    invoke-static {p0}, Landroid/text/TextUtils;->isEmpty(Ljava/lang/CharSequence;)Z
+
+    move-result v0
+
+    if-eqz v0, :cond_0
+
+    const/4 v0, 0x0
+
+    return v0
+
+    :cond_0
+    const-string v0, "CN"
+
+    invoke-virtual {v0, p0}, Ljava/lang/String;->equalsIgnoreCase(Ljava/lang/String;)Z
+
+    move-result v0
+
+    return v0
+.end method
+
 
 # virtual methods
 .method public final A()V
@@ -3751,7 +3774,9 @@
     return-object p0
 
     :cond_19
-    invoke-virtual {p0}, Lv7/b;->w()Z
+    sget-object p0, Lv7/c;->n:Ljava/lang/String;
+
+    invoke-static {p0}, Lv7/b;->isChinaRegion(Ljava/lang/String;)Z
 
     move-result p0
 
